# Example answers for a non-interactive run:
#
#   sudo NAS_PASSWORD='...' bash setup.sh --config setup.conf
#
# Copy this file, fill in your own values and keep the copy out of git
# (setup.conf is in .gitignore). Every value here is a placeholder.
# The NAS password is never stored in this file; pass it in NAS_PASSWORD or
# let the script reuse /etc/ipfs-setup/smb-credentials from an earlier run.

# NAS share (SMB/CIFS)
NAS_SHARE=//nas.example.lan/ipfs
NAS_MOUNT=/mnt/ipfs
NAS_USER=ipfs-backup
NAS_DOMAIN=
# 3.1.1 (default), 3.0, 2.1, 2.0 or 1.0 (insecure; only for NAS devices without anything newer)
SMB_VERS=3.1.1

# Kubo container
KUBO_TAG=latest
# unless-stopped (default), always, on-failure or no
RESTART_POLICY=unless-stopped

# API access (CORS). Comma-separated.
CORS_ORIGINS=http://ipfs-node.local:5001,http://localhost:5001,http://127.0.0.1:5001
CORS_METHODS=PUT,POST,GET
CID_VERSION=1
# Chunk size for content added without its own (files up to it stay one
# block). Blank = Kubo's default (256 KiB). A size like 1MiB or 512KiB, or a
# Kubo chunker string (size-1048576, rabin-..., buzhash). Max 2,096,896 bytes.
IMPORT_CHUNKER=
# Storage limit, e.g. 10GB (default), 500GB, 1.5TB, 200GiB. Garbage collection
# then deletes cached content once the repo nears it; pinned and MFS content
# is never deleted. 'none' = no limit, garbage collection off.
STORAGE_MAX=10GB
# Small device (Raspberry Pi etc.): Kubo's lowpower connection limits.
LOW_POWER=false
# default = Kubo's routing; home = use the network without serving it, and
# announce only pinned and MFS content
NODE_ROUTING=default

# Router dynamic DNS name announced to peers outside your network (blank to skip)
ANNOUNCE_HOST=myhome.ddns.example

# LAN allowed to reach the API (5001) and gateway (8080)
LAN_CIDR=192.168.1.0/24

# Backup
BACKUP_SUBDIR=backup
# How often: daily (default), hourly, weekly, monthly or custom
BACKUP_FREQUENCY=daily
# Time for daily/weekly/monthly: 02:00, 21:30, 2am, 9:30pm ...
BACKUP_TIME=02:00
# hourly: run every 1, 2, 3, 4, 6, 8 or 12 hours
BACKUP_EVERY_HOURS=6
# weekly: day names, e.g. Sun, Mon,Thu, weekdays or weekends
BACKUP_DAYS=Sun
# monthly: day of the month, 1-28
BACKUP_MONTHDAY=1
# custom: a systemd OnCalendar expression (see 'man systemd.time').
# For the other frequencies this is generated from the settings above.
BACKUP_SCHEDULE='*-*-* 02:00:00'
MIRROR_DELETES=false
# Save these settings (never the password) to <share>/ipfs-setup/setup.conf
# when setup finishes, for another machine or a reinstall.
NAS_SAVE_CONFIG=true
BACKUP_NODE_CONFIG=false

# Import of an existing backup folder
IMPORT_HIDDEN=false
# skip (default), replace or rename
IMPORT_CONFLICT=skip
